# Railway Environment Variables Template
# Copy these values to Railway dashboard Variables tab
# DO NOT commit this file with actual values

# ===========================================
# REQUIRED - Database
# ===========================================
# Supabase PostgreSQL connection string
# Format: postgresql://postgres:[YOUR_PASSWORD]@[PROJECT_REF].supabase.co:5432/postgres
# If using Supabase pooler: postgresql://postgres:[YOUR_PASSWORD]@[PROJECT_REF].pooler.supabase.com:5432/postgres
DATABASE_URL=

# ===========================================
# REQUIRED - Application
# ===========================================
NODE_ENV=production
PORT=4000

# ===========================================
# REQUIRED - Security Secrets
# Generate with: openssl rand -hex 32 (for JWT_SECRET and NEXTAUTH_SECRET)
# Generate with: openssl rand -base64 32 | head -c 32 (for ENCRYPTION_KEY)
# ===========================================
JWT_SECRET=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# ===========================================
# REQUIRED - URLs
# After first deploy, update these with your Railway public domain
# Example: https://open-hide-production.up.railway.app
# ===========================================
FRONTEND_URL=https://${RAILWAY_PUBLIC_DOMAIN}
NEXTAUTH_URL=https://${RAILWAY_PUBLIC_DOMAIN}
CORS_ORIGIN=https://${RAILWAY_PUBLIC_DOMAIN}
SERVER_URL=https://${RAILWAY_PUBLIC_DOMAIN}

# ===========================================
# REQUIRED - MCP Authentication
# Options: oauth2, legacy, both, none
# ===========================================
MCP_AUTH_MODE=both

# ===========================================
# OPTIONAL - MCP Legacy Auth (only if MCP_AUTH_MODE is 'legacy' or 'both')
# ===========================================
# MCP_BEARER_TOKEN=
# MCP_API_KEY=

# ===========================================
# OPTIONAL - Rate Limiting (requires Redis)
# ===========================================
# REDIS_URL=${{redis.REDIS_URL}}
MCP_RATE_LIMIT_PER_MINUTE=60

# ===========================================
# OPTIONAL - Email (SMTP)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com
# SMTP_FROM_NAME=AnythingMCP

# ===========================================
# OPTIONAL - Registration
# ===========================================
# Set to true to allow open registration
ALLOW_OPEN_REGISTRATION=false
